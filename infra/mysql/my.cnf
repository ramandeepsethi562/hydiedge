[mysqld]
# ============================================================================
# HYDIEMS MYSQL 8.0 PRODUCTION CONFIGURATION
# Tuned for 128 GB RAM / 12-Core AMD Ryzen 9 / 3.5 TB NVMe SSD
# Allocated RAM Budget: 36 GB InnoDB Buffer Pool
# ============================================================================

user                            = mysql
pid-file                        = /var/run/mysqld/mysqld.pid
socket                          = /var/run/mysqld/mysqld.sock
port                            = 3306
datadir                         = /var/lib/mysql
default-storage-engine          = InnoDB
character-set-server            = utf8mb4
collation-server                = utf8mb4_unicode_ci
default-time-zone               = '+00:00'
skip-name-resolve               = ON

# InnoDB Memory & Buffer Pool (36 GB across 12 instances for 12-core Ryzen 9)
innodb_buffer_pool_size         = 36G
innodb_buffer_pool_instances    = 12
innodb_log_buffer_size          = 64M
innodb_redo_log_capacity        = 8G
innodb_flush_log_at_trx_commit  = 2
innodb_flush_method             = O_DIRECT

# NVMe SSD I/O Concurrency Tuning
innodb_io_capacity              = 10000
innodb_io_capacity_max          = 25000
innodb_read_io_threads          = 8
innodb_write_io_threads         = 8
innodb_page_cleaners            = 8
innodb_file_per_table           = ON

# Connection & Buffer Limits
max_connections                 = 2000
max_connect_errors              = 100000
thread_cache_size               = 128
table_open_cache                = 8192
table_definition_cache          = 4096
tmp_table_size                  = 128M
max_heap_table_size             = 128M
max_allowed_packet              = 64M

# Slow Query & Performance Diagnostics
slow_query_log                  = 1
long_query_time                 = 1.0
log_queries_not_using_indexes   = 0
binlog_expire_logs_seconds      = 604800
